model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: et-EE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_date","dim_customer","dim_product","dim_salesrep","dim_region","fact_sales"]

ref table dim_date
ref table dim_customer
ref table dim_product
ref table dim_salesrep
ref table dim_region
ref table fact_sales

ref cultureInfo en-US

