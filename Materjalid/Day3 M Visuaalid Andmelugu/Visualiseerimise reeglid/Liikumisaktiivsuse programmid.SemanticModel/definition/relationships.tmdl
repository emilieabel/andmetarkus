relationship fact_activity_to_dim_direction
	fromColumn: fact_activity.who_direction_id
	toColumn: dim_direction.direction_id

relationship fact_activity_to_dim_date
	fromColumn: fact_activity.Alguskuupäev
	toColumn: dim_date.Kuupäev

relationship fact_activity_end_to_dim_date
	isActive: false
	fromColumn: fact_activity.Lõppkuupäev
	toColumn: dim_date.Kuupäev

relationship fact_activity_to_dim_organization
	fromColumn: fact_activity.lead_org_id
	toColumn: dim_organization.organization_id

