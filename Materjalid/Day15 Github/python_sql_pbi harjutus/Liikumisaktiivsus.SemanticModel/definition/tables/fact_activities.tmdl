table fact_activities
	lineageTag: 8d4f2b01-5c3e-4f90-ad2b-3e5f7a9c1d23

	measure 'Organisatsioonide arv' = DISTINCTCOUNT ( dim_organizations[organization_id] )
		formatString: #,##0
		lineageTag: b22e3c44-d55e-4f66-9077-8899aabbcc11

	measure 'Tegevuste arv' = COUNTROWS ( fact_activities )
		formatString: #,##0
		lineageTag: b22e3c44-d55e-4f66-9077-8899aabbcc12

	measure 'Tehtud tegevuste arv' =
			
			CALCULATE (
			    COUNTROWS ( fact_activities ),
			    fact_activities[status] = "Tehtud"
			)
		formatString: #,##0
		lineageTag: b22e3c44-d55e-4f66-9077-8899aabbcc13

