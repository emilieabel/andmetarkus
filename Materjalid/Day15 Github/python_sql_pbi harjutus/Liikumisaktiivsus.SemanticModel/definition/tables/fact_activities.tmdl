	partition fact_activities = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "postgres"),
				    Data = Value.NativeQuery(Source, "select * from analytics.fact_activities", null, [EnableFolding=true])
				in
				    Data

