	partition dim_date = calculated
		mode: import
		source =
				SELECTCOLUMNS (
				    CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2030, 12, 31 ) ), ---reavahetus SHIFT + ENTER
				    "Kuupäev", [Date], ---taandrida TAB
				    "Kuu",MONTH([Date]),
				    "Aasta",YEAR([Date]),
				    "Päev nr",DAY([Date])
				)

	annotation PBI_Id = 4a30e8b2acb443048785e70d8ffd0fe0

