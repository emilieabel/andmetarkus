				    #"Renamed Columns" = Table.RenameColumns(#"Expanded Column1", {{"id", "activity_id"}, {"nr", "Tegevuse nr"}, {"code", "Kood"}, {"name", "Tegevus"}, {"name_short", "Lühinimi"}, {"activity_type", "Tegevuse tüüp"}, {"period", "Periood"}, {"start_date", "Alguskuupäev"}, {"end_date", "Lõppkuupäev"}, {"status", "Staatus"}, {"target_outcome", "Sihttulemus"}, {"progress_pct", "Edenemine protsent"}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns", each [partner_ids], each if [partner_ids] = null then {null} else if List.IsEmpty([partner_ids]) then {null} else [partner_ids], Replacer.ReplaceValue, {"partner_ids"}),
				    #"Expanded partner_ids" = Table.ExpandListColumn(#"Replaced Value", "partner_ids"),
				    #"Merged Queries" = Table.NestedJoin(#"Expanded partner_ids", {"partner_ids"}, dim_organization, {"organization_id"}, "dim_organization", JoinKind.LeftOuter),
				    #"Expanded dim_organization" = Table.ExpandTableColumn(#"Merged Queries", "dim_organization", {"Organisatsioon"}, {"Partner nimi"}),
				    #"Grouped Rows" = Table.Group(#"Expanded dim_organization", {"activity_id", "Tegevuse nr", "Kood", "Tegevus", "Lühinimi", "Tegevuse tüüp", "Periood", "Alguskuupäev", "Lõppkuupäev", "Staatus", "Sihttulemus", "who_direction_id", "lead_org_id", "Edenemine protsent"}, {{"Partnerid", each Text.Combine(List.Distinct(List.RemoveNulls([Partner nimi])), ", "), type text}}),
