	/// Partnerasutused ühel väljal, komadega.
	column Partnerid
		dataType: string
		lineageTag: 7c8a1f2e-3b4d-4e5f-9a0b-1c2d3e4f5a6b
		summarizeBy: none
		sourceColumn: Partnerid

	/// Kestus päevades Alguskuupäev-Lõppkuupäev; tekst peab ühtima dim_kestus_grupp ridadega.
	column 'Kestuse grupp' =
			IF (
			    ISBLANK ( fact_activity[Alguskuupäev] ) || ISBLANK ( fact_activity[Lõppkuupäev] ),
			    "Kuupäev puudub",
			    VAR Paevi =
			        DATEDIFF ( fact_activity[Alguskuupäev], fact_activity[Lõppkuupäev], DAY )
			    RETURN
			        SWITCH (
			            TRUE (),
			            Paevi < 365, "0-1 aastat",
			            Paevi < 3 * 365, "1-3 aastat",
			            Paevi < 5 * 365, "3-5 aastat",
			            "5+ aastat"
			        )
			)
		dataType: string
		lineageTag: 15818916-75ab-4fb7-a40c-94c908d11f48
		summarizeBy: none

	hierarchy 'Tegevuse tüüp ja staatus'
		lineageTag: 5bcbef92-b8b1-4faf-abd9-0ae1086379b1

		level 'Tegevuse tüüp'
			lineageTag: ba2f62a1-edd6-46b5-81df-b6679950a83d
			column: 'Tegevuse tüüp'

		level Staatus
			lineageTag: 61ccd2b9-9d7c-45d5-a27b-31cacfaa3280
			column: Staatus

